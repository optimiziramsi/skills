#!/usr/bin/env python3
"""upkeep — what the upkeep plugin sees for the current project.

  upkeep status          updates available + plugins new to the watched marketplaces
  upkeep status --json   the same, machine-readable (for the /upkeep skill)
  upkeep marketplaces    the marketplaces watched for this project
"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks"))
import _upkeep as up  # noqa: E402


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "status"
    project = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
    if cmd == "status":
        rep = up.report(project, remember=False)
        if "--json" in argv:
            print(json.dumps(rep, indent=1))
            return 0
        for pid, scope, old, new in rep["updates"]:
            print(f"update\t{pid}\t{scope}\t{old} → {new}")
        for m, n, desc in rep["new"]:
            print(f"new\t{n}@{m}\t{desc}")
        if not rep["updates"] and not rep["new"]:
            print("(nothing to do)", file=sys.stderr)
    elif cmd == "marketplaces":
        print("\n".join(up.watched(up.installs(project))))
    else:
        print(__doc__.strip())
        return 0 if cmd in ("help", "-h", "--help") else 2
    return 0


sys.exit(main(sys.argv))

#!/usr/bin/env bash
# relay-watch — the `relay` skill's comment watcher (on PATH while the worktree plugin is enabled).
#
# Watches the shared relay worktree for NEW comment lines in the user's uncommitted edits (staged or
# not: `git diff HEAD`) and prints one event line per:
#   TRIGGER <file>: <line>      a new comment line carrying a handover phrase (case-insensitive; the
#                               full list, human-readable, prints after this header on --help)
#   QUIET <file>: <n> new comment line(s), untouched <age>s — candidate for pickup
#                               a file with new comment lines nobody has touched for QUIET_SECS
# Each event fires once (state dir keeps what was seen); a changed comment set fires again. A file
# whose TRIGGER fired is not also QUIET-reported for the same comment set.
# Skips `.agent/`, `.todo*`, `*.md`, and every line the primary itself writes — all of them carry the
# `relay:` prefix right after the comment marker (`// relay: addressed in <slug> worktree chat`).
#
#   relay-watch <worktree> <state-dir> [quiet-secs=600] [poll-secs=10]   loop — run it via Monitor
#   relay-watch --once <worktree> <state-dir> [quiet-secs]               one scan, then exit
#   relay-watch --seed <worktree> <state-dir>                            mark the current comments as seen, emit nothing
#   relay-watch --test                                                   self-test
#
# Portable: macOS (`md5 -q`, `stat -f %m`) and Linux (`md5sum`, `stat -c %Y`).
set -u

TRIGGER='(^|[^A-Za-z-])(RELAY|READY|TAKE ?OVER|NOW YOU|DO IT|GO AHEAD|SCHEDULED|YOUR TURN|PICK (THIS|IT) UP)([^A-Za-z-]|$)'
TAB=$'\t'
# a real tab: POSIX grep -E has no \t escape (it would be a literal t), so the row "<file><TAB><line>" must be built with one
EXCLUDE_RX="^[^${TAB}]*${TAB}[[:space:]]*(//|#|/\*|\*|<!--)[[:space:]]*relay:"

digest() {  # stdin → hex digest
  if command -v md5 >/dev/null 2>&1; then md5 -q
  elif command -v md5sum >/dev/null 2>&1; then md5sum | cut -d' ' -f1
  else shasum | cut -d' ' -f1; fi
}

mtime() {  # file → epoch seconds
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

# --- handover-phrase list, generated from TRIGGER (so --help can never drift from the regex) ---
_split_alts() {  # $1 inner regex → fills _ALTS with its top-level |-separated pieces (paren-aware)
  local s=$1 c depth=0 cur=""; _ALTS=()
  while [ -n "$s" ]; do
    c=${s:0:1}; s=${s:1}
    case $c in
      '(') depth=$((depth + 1)); cur+=$c ;;
      ')') depth=$((depth - 1)); cur+=$c ;;
      '|') if [ "$depth" -eq 0 ]; then _ALTS+=("$cur"); cur=""; else cur+=$c; fi ;;
      *) cur+=$c ;;
    esac
  done
  _ALTS+=("$cur")
}

_expand() {  # $1 prefix, $2 remaining regex → one printed line per literal expansion
  local pre=$1 r=$2 c rest n depth inner opts o
  [ -n "$r" ] || { printf '%s\n' "$pre"; return; }
  c=${r:0:1}; rest=${r:1}
  if [ "$c" = "(" ]; then          # group: recurse on each top-level alternative
    depth=1; inner=""
    while [ -n "$rest" ]; do
      n=${rest:0:1}; rest=${rest:1}
      [ "$n" = "(" ] && depth=$((depth + 1))
      [ "$n" = ")" ] && { depth=$((depth - 1)); [ "$depth" -eq 0 ] && break; }
      inner+=$n
    done
    _split_alts "$inner"; opts=("${_ALTS[@]}")
    for o in "${opts[@]}"; do _expand "$pre" "$o$rest"; done
    return
  fi
  if [ "${rest:0:1}" = "?" ]; then  # optional preceding char → with and without it
    rest=${rest:1}
    _expand "$pre$c" "$rest"; _expand "$pre" "$rest"
    return
  fi
  _expand "$pre$c" "$rest"
}

phrases() {  # $1 TRIGGER regex → each handover phrase it matches, one per line (derived, never hand-kept)
  local core alt tops
  core=${1#*)(}; core=${core%)(*}   # strip the (^|…) prefix and (…|$) suffix boundaries
  _split_alts "$core"; tops=("${_ALTS[@]}")
  for alt in "${tops[@]}"; do _expand "" "$alt"; done
}

scan() {  # $1 worktree → writes "<file>\t<comment line>" rows to $2
  git -C "$1" diff HEAD -U0 --no-color -- . ':!.agent' ':!.todo*' ':!*.md' 2>/dev/null \
    | awk '/^\+\+\+ b\//{f=substr($0,7); next}
           /^\+/{ s=substr($0,2); if (s ~ /^[[:space:]]*(\/\/|#|\/\*|\*|<!--)/) print f "\t" s }' \
    | grep -vE "$EXCLUDE_RX" > "$2" || true
}

tick() {  # $1 worktree, $2 state dir, $3 quiet secs
  local wt="$1" state="$2" quiet="$3" f s key h n m age now
  scan "$wt" "$state/cur"
  grep -iE "$TRIGGER" "$state/cur" | while IFS=$'\t' read -r f s; do
    key=$(printf '%s\t%s' "$f" "$s" | digest)
    grep -q "$key" "$state/seen_trigger" && continue
    echo "TRIGGER $f: $s"; echo "$key" >> "$state/seen_trigger"
    # a handed-over file is spoken for: mute QUIET for its current comment set
    grep -F "$(printf '%s\t' "$f")" "$state/cur" | digest >> "$state/seen_quiet"
  done
  now=$(date +%s)
  cut -f1 "$state/cur" | sort -u | while read -r f; do
    [ -n "$f" ] && [ -f "$wt/$f" ] || continue
    m=$(mtime "$wt/$f"); age=$((now - m)); [ "$age" -ge "$quiet" ] || continue
    h=$(grep -F "$(printf '%s\t' "$f")" "$state/cur" | digest)
    grep -q "$h" "$state/seen_quiet" && continue
    n=$(grep -cF "$(printf '%s\t' "$f")" "$state/cur")
    echo "QUIET $f: $n new comment line(s), untouched ${age}s — candidate for pickup"
    echo "$h" >> "$state/seen_quiet"
  done
}

seed() {  # $1 worktree, $2 state dir → every current comment line counts as seen (TRIGGER and QUIET)
  scan "$1" "$2/cur"
  while IFS=$'\t' read -r f s; do
    [ -n "$f" ] || continue
    printf '%s\t%s' "$f" "$s" | digest >> "$2/seen_trigger"
  done < "$2/cur"
  cut -f1 "$2/cur" | sort -u | while read -r f; do
    [ -n "$f" ] || continue
    grep -F "$(printf '%s\t' "$f")" "$2/cur" | digest >> "$2/seen_quiet"
  done
}

prepare() {  # $1 worktree, $2 state dir
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "relay-watch: $1 is not a git worktree" >&2; exit 1; }
  mkdir -p "$2" && touch "$2/seen_trigger" "$2/seen_quiet"
}

selftest() {
  local tmp wt st out rc fails=0
  tmp=$(mktemp -d) && wt="$tmp/wt" && st="$tmp/state"
  pass() { echo "PASS  $1"; }
  fail() { echo "FAIL  $1: $2"; fails=$((fails + 1)); }
  git init -q "$wt" && git -C "$wt" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  printf 'a = 1\n' > "$wt/x.py"; printf 'ok\n' > "$wt/notes.md"
  git -C "$wt" add -A && git -C "$wt" -c user.name=t -c user.email=t@t commit -q -m base
  # 1. a handover phrase fires TRIGGER once
  printf 'a = 1\n# rename this, RELAY\n' > "$wt/x.py"
  out=$("$0" --once "$wt" "$st" 600)
  grep -q '^TRIGGER x.py: # rename this, RELAY$' <<<"$out" && pass "trigger fires" || fail "trigger fires" "$out"
  out=$("$0" --once "$wt" "$st" 600)
  [ -z "$out" ] && pass "trigger fires once" || fail "trigger fires once" "$out"
  out=$("$0" --once "$wt" "$st" 0)
  [ -z "$out" ] && pass "no QUIET for a file already handed over" || fail "no QUIET for a file already handed over" "$out"
  # 2. a plain comment is quiet-reported only after QUIET_SECS, once per content
  printf 'a = 1\n# rename this, RELAY\n# and drop b\n' > "$wt/x.py"
  out=$("$0" --once "$wt" "$st" 600)
  [ -z "$out" ] && pass "fresh edit is not yet quiet" || fail "fresh edit is not yet quiet" "$out"
  out=$("$0" --once "$wt" "$st" 0)
  grep -q '^QUIET x.py: 2 new comment line(s), untouched [0-9]*s' <<<"$out" && pass "quiet reports" || fail "quiet reports" "$out"
  out=$("$0" --once "$wt" "$st" 0)
  [ -z "$out" ] && pass "quiet reports once" || fail "quiet reports once" "$out"
  # 3. markdown, .agent and the primary's annotations are ignored; staged edits count
  printf 'ok\n<!-- DO IT -->\n' > "$wt/notes.md"
  mkdir -p "$wt/.agent" && printf '# RELAY\n' > "$wt/.agent/relay.md" && git -C "$wt" add -A
  printf 'a = 1\n# rename this, RELAY\n# and drop b\n# relay: addressed in relay-x worktree chat\n  // relay: audit — RELAY this is ours\n' > "$wt/x.py"
  out=$("$0" --once "$wt" "$st" 0)
  [ -z "$out" ] && pass "md/.agent/relay: lines ignored" || fail "md/.agent/relay: lines ignored" "$out"
  # 3a. a relay: line whose text carries a trigger word fires neither TRIGGER nor QUIET, on a fresh state
  rm -rf "$st"; printf 'a = 1\n// relay: audit — RELAY appears here, READY too\n# relay: addressed in relay-x worktree chat\n' > "$wt/x.py"
  out=$("$0" --once "$wt" "$st" 0)
  [ -z "$out" ] && pass "relay: prefix beats the trigger words" || fail "relay: prefix beats the trigger words" "$out"
  # 3b. --seed marks pre-existing comments as seen on a fresh state dir
  rm -rf "$st"; printf 'a = 1\n# old note, READY\n# older note\n' > "$wt/x.py"
  "$0" --seed "$wt" "$st" >/dev/null
  out=$("$0" --once "$wt" "$st" 0)
  [ -z "$out" ] && pass "seed silences pre-existing comments" || fail "seed silences pre-existing comments" "$out"
  printf 'a = 1\n# old note, READY\n# older note\n# new one, DO IT\n' > "$wt/x.py"
  out=$("$0" --once "$wt" "$st" 600)
  grep -q '^TRIGGER x.py: # new one, DO IT$' <<<"$out" && pass "new comment after seed fires" || fail "new comment after seed fires" "$out"
  # 4. phrase inside a word does not fire
  printf 'a = 1\n# unready path\n' > "$wt/x.py"
  out=$("$0" --once "$wt" "$st" 600)
  [ -z "$out" ] && pass "no trigger inside a word" || fail "no trigger inside a word" "$out"
  # 5. --help prints the phrase list generated from TRIGGER (every alternative) and exits 0
  out=$("$0" --help); rc=$?
  { [ "$rc" -eq 0 ] \
    && grep -q 'RELAY' <<<"$out" && grep -q 'TAKE OVER' <<<"$out" \
    && grep -q 'TAKEOVER' <<<"$out" && grep -q 'PICK IT UP' <<<"$out" \
    && grep -q 'PICK THIS UP' <<<"$out"; } \
    && pass "help lists phrases from TRIGGER" || fail "help lists phrases from TRIGGER" "rc=$rc $out"
  rm -rf "$tmp"
  [ "$fails" -eq 0 ] && echo "all tests passed" || echo "$fails FAILED"
  return "$fails"
}

case "${1:-}" in
  --test) selftest; exit $? ;;
  --once) shift; [ $# -ge 2 ] || { echo "usage: relay-watch --once <worktree> <state-dir> [quiet-secs]" >&2; exit 1; }
          prepare "$1" "$2"; tick "$1" "$2" "${3:-600}"; exit 0 ;;
  --seed) shift; [ $# -ge 2 ] || { echo "usage: relay-watch --seed <worktree> <state-dir>" >&2; exit 1; }
          prepare "$1" "$2"; seed "$1" "$2"; echo "seeded $(wc -l < "$2/cur" | tr -d ' ') comment line(s) as seen"; exit 0 ;;
  ""|-h|--help)
    sed -n '2,18p' "$0"
    printf '\nHandover phrases (case-insensitive; generated from the TRIGGER regex):\n'
    phrases "$TRIGGER" | sort -u | sed 's/^/  /'
    exit 0 ;;
esac
[ $# -ge 2 ] || { echo "usage: relay-watch <worktree> <state-dir> [quiet-secs] [poll-secs]" >&2; exit 1; }
prepare "$1" "$2"
while true; do tick "$1" "$2" "${3:-600}"; sleep "${4:-10}"; done
